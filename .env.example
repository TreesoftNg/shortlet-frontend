# Nest API origin (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Must equal tenants.slug for this deploy (seeded as sunmade).
# Sent as X-Tenant-Slug when Origin host is not under a registered domain.
NEXT_PUBLIC_TENANT_SLUG=sunmade

# Where unit photos are served from (the API's MEDIA_PUBLIC_BASE_URL). Read at
# build time; defaults to the production S3 bucket.
MEDIA_PUBLIC_BASE_URL=https://sunmade-s3.s3.us-east-1.amazonaws.com
