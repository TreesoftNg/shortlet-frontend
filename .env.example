# Copy to `.env.local` and adjust.

# Shortlet API origin (no /api/v1 suffix — paths add that in code).
# Local:  http://localhost:4000
# Staging: https://api-staging.sunmadeapartments.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Required on localhost when the API cannot resolve tenant from Origin.
NEXT_PUBLIC_TENANT_SLUG=sunmade
